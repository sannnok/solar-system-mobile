# Токены ботов — получите у @BotFather (/newbot). Для inline-режима: /setinline.
BIAS_BOT_TOKEN=
HEALTH_BOT_TOKEN=

# Имена ботов без @ — нужны для перекрёстных ссылок между ботами и в роликах
BIAS_BOT_USERNAME=
HEALTH_BOT_USERNAME=

# Ваш Telegram ID (узнать — @userinfobot): команда /stats в обоих ботах
ADMIN_IDS=

# Канал для ежедневного поста «искажение дня» (бот должен быть админом канала)
CHANNEL_ID=
CHANNEL_POST_HOUR=10

# Часовой пояс расписаний, минуты к UTC (180 = Москва)
TZ_OFFSET=180

# Где хранить базу (SQLite)
DB_PATH=state/bots.db

# HTTP API для n8n: порт и ключ (заголовок x-api-key)
PORT=8787
API_KEY=

# Адрес Mini App «интерактивная карта» (HTTPS). Например, GitHub Pages:
# https://<user>.github.io/<repo>/bias-bots/webapp/  или  https://ваш-домен/webapp/
WEBAPP_URL=

# Сценарии роликов через Claude (необязательно; без ключа — шаблон)
ANTHROPIC_API_KEY=
# SCRIPT_MODEL=claude-opus-5-5

# Фоновая музыка для роликов (mp3), необязательно
MUSIC_FILE=

# Рубрика «Доказано наукой» в ЗОЖ-боте: цена разблокировки в Telegram Stars
# (50 ⭐ ≈ $1 для покупателя; точный курс зависит от платформы). FACTS_FREE=1 — открыть всем.
FACTS_PRICE_STARS=50
FACTS_FREE=

# Стиль роликов: dynamic (Remotion — анимация, переходы, эффекты; ~1 мин рендера) или simple (ffmpeg-слайды, ~10 с)
VIDEO_STYLE=dynamic
# Путь к chrome-headless-shell для Remotion (по умолчанию Remotion скачает свой)
REMOTION_BROWSER=
